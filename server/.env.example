# Copy this file to .env and fill in YOUR values. .env is git-ignored; this file is committed,
# so it must only ever contain placeholders.

# --- Server ---
NODE_ENV=development
PORT=5000
# Frontend origin(s) allowed by CORS. Comma-separated for more than one.
CLIENT_URL=http://localhost:5173

# --- MongoDB ---
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017/ecommerce   (note: transactions need a replica set)
MONGO_URI=mongodb://127.0.0.1:27017/multiecommerce

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- First admin account (only used by: npm run seed:admin) ---
# Admins can't register through the API. Set these, run the script once, then remove the password.
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# --- Cloudinary (Week 2: product images) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Stripe (Week 3: checkout). Use TEST keys only. ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Email / Nodemailer (transactional emails) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-smtp-username
EMAIL_PASS=your-smtp-password
EMAIL_FROM="Your Store <no-reply@example.com>"
